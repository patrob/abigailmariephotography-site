---
import Layout from "../layouts/Layout.astro";

const heroImage =
  "/images/img_0865.jpg";

const contactImage =
  "/images/contact-photo-abbie.jpg";

const contactEmail =
  "info@abigailmariephotography.com";
---

<Layout title="Contact" description="Get in touch with Abigail Marie Photography to book your family, lifestyle, or milestone session in San Antonio or New Braunfels.">
  <section class="page-hero">
    <img src={heroImage} alt="Contact hero" class="hero-image" />
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <p class="eyebrow">Let's Connect</p>
      <h1>Contact</h1>
    </div>
  </section>

  <section class="contact-section">
    <div class="container contact-grid">
      <form class="contact-form reveal" data-contact-form>
        <div class="contact-form-status" data-contact-status role="status" aria-live="polite" hidden></div>
        <div class="contact-form-honeypot" aria-hidden="true">
          <label for="website">Website</label>
          <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
        </div>
        <div>
          <label for="name">Name</label>
          <input type="text" id="name" name="name" autocomplete="name" required />
        </div>
        <div>
          <label for="email">Email</label>
          <input type="email" id="email" name="email" autocomplete="email" required />
        </div>
        <div>
          <label for="phone">Phone</label>
          <input type="tel" id="phone" name="phone" autocomplete="tel" />
        </div>
        <div>
          <label for="sessionType">Session Type</label>
          <select id="sessionType" name="sessionType" required>
            <option value="">Select a session</option>
            <option>Family</option>
            <option>Lifestyle</option>
            <option>Newborn</option>
            <option>Maternity</option>
            <option>Birth Photography</option>
            <option>Milestone</option>
            <option>Other</option>
          </select>
        </div>
        <div>
          <label for="sessionDate">Session Date / Due Date</label>
          <input type="text" id="sessionDate" name="sessionDate" placeholder="Date, due date, or general timing" />
        </div>
        <div>
          <label for="preferredLocation">Preferred Location</label>
          <input type="text" id="preferredLocation" name="preferredLocation" />
        </div>
        <div>
          <label for="referralSource">How did you hear about me?</label>
          <input type="text" id="referralSource" name="referralSource" />
        </div>
        <div>
          <label for="message">Tell me what you're dreaming of</label>
          <textarea id="message" name="message" rows="6" required></textarea>
        </div>
        <button type="submit" class="btn btn-accent">Send Inquiry</button>
      </form>

      <div class="contact-info reveal">
        <img src={contactImage} alt="Abigail, Abigail Marie Photography" class="contact-photo" />

        <h3>Reach Out</h3>
        <p>
          <a href="tel:2105426718">(210) 542-6718</a>
        </p>
        <p>
          <a href={`mailto:${contactEmail}`}>{contactEmail}</a>
        </p>

        <h3>Location</h3>
        <p>Serving San Antonio and New Braunfels</p>
      </div>
    </div>
  </section>

  <script>
    const form = document.querySelector("[data-contact-form]");
    const status = document.querySelector("[data-contact-status]");

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();

      if (!(form instanceof HTMLFormElement) || !(status instanceof HTMLElement)) {
        return;
      }

      const submitButton = form.querySelector('button[type="submit"]');
      const formData = new FormData(form);
      const payload = Object.fromEntries(formData.entries());

      status.className = "contact-form-status";
      status.textContent = "Sending your inquiry...";
      status.hidden = false;
      if (submitButton instanceof HTMLButtonElement) {
        submitButton.disabled = true;
      }

      try {
        const response = await fetch("/api/contact", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });
        const result = await response.json().catch(() => ({}));

        if (!response.ok) {
          throw new Error(result?.error || "The form could not be sent. Please try again.");
        }

        form.reset();
        status.textContent = "Thank you. Your inquiry has been sent.";
        status.classList.add("contact-form-status--success");
      } catch (error) {
        status.textContent = error instanceof Error
          ? error.message
          : "The form could not be sent. Please try again.";
        status.classList.add("contact-form-status--error");
      } finally {
        if (submitButton instanceof HTMLButtonElement) {
          submitButton.disabled = false;
        }
      }
    });
  </script>
</Layout>
