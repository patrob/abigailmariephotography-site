---

<Layout title="Gallery" description="Browse family, lifestyle, and milestone photography sessions by Abigail Marie Photography serving San Antonio and New Braunfels.">
  <section class="page-hero">
    <img src={heroImage} alt="Gallery hero" class="hero-image" />
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <p class="eyebrow">Portfolio</p>
      <h1>Gallery</h1>
    </div>
  </section>

  <section class="gallery-section gallery-booking-section">
    <div class="container">
      <div class="cta-row reveal">
        <a href="/packages" class="btn btn-accent">Book a Session</a>
      </div>
    </div>
  </section>

  <section class="gallery-index-section">
    <div class="container">
      <div class="section-narrow reveal">
        <span class="eyebrow-label">Sessions</span>
        <h2>Browse by Session</h2>
      </div>
      <nav class="session-index-grid reveal" aria-label="Gallery sessions">
        {
          sessions.map((session, sessionIndex) => (
            <a
              href={`#${session.id}`}
              class="session-index-card"
              aria-label={`View ${session.title} ${sessionIndex + 1}`}
            >
              <img src={session.images[0]} alt="" loading="lazy" />
              <span>{session.eyebrow}</span>
              <strong>{session.title}</strong>
            </a>
          ))
        }
      </nav>
    </div>
  </section>

  {
    sessions.map((session, sessionIndex) => (
      <section
        id={session.id}
        class:list={["gallery-section", sessionIndex % 2 === 1 && "gallery-section--soft"]}
        aria-labelledby={`${session.id}-title`}
      >
        <div class="container">
          <div class="section-narrow gallery-session-heading reveal">
            <span class="eyebrow-label">{session.eyebrow}</span>
            <h2 id={`${session.id}-title`}>{session.title}</h2>
            <button
              type="button"
              class="session-share-button"
              data-share-target={`#${session.id}`}
              data-share-title={session.title}
            >
              Share Session
            </button>
            <span class="session-copy-status" aria-live="polite"></span>
          </div>
          <div class="masonry reveal">
            {
              session.images.map((src, i) => (
                <figure>
                  <img src={src} alt={`${session.eyebrow} portfolio image ${i + 1}`} loading="lazy" />
                </figure>
              ))
            }
          </div>
        </div>
      </section>
    ))
  }

  <section class="gallery-section gallery-booking-section">
    <div class="container">
      <div class="cta-row reveal">
        <a href="/packages" class="btn btn-accent">Book a Session</a>
      </div>
    </div>
  </section>

  <script>
    document.querySelectorAll("[data-share-target]").forEach((button) => {
      button.addEventListener("click", async () => {
        const target = button.getAttribute("data-share-target");
        const title = button.getAttribute("data-share-title") || "Gallery session";
        const status = button.parentElement?.querySelector(".session-copy-status");
        const originalLabel = button.textContent || "Share Session";
        const url = new URL(target || "", window.location.href).href;

        try {
          if (navigator.share) {
            await navigator.share({ title, url });
          } else {
            await navigator.clipboard.writeText(url);
          }

          button.textContent = "Link Copied";
          status && (status.textContent = "Session link copied.");
          window.setTimeout(() => {
            button.textContent = originalLabel;
            status && (status.textContent = "");
          }, 2200);
        } catch (error) {
          if (error instanceof DOMException && error.name === "AbortError") {
            return;
          }

          status && (status.textContent = "Could not copy link.");
        }
      });
    });
  </script>
</Layout>
