---
import Layout from "../layouts/Layout.astro";
import sessions from "../data/smugmugGallery.json";

const heroImage =
  "/images/805a1137.jpg";
---

<Layout title="Gallery" description="Browse family, lifestyle, and milestone photography sessions by Abigail Marie Photography serving San Antonio and New Braunfels.">
  <section class="page-hero">
    <img src={heroImage} alt="Gallery hero" class="hero-image" />
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <p class="eyebrow">Portfolio</p>
      <h1>Gallery</h1>
    </div>
  </section>

  <section class="gallery-section gallery-booking-section">
    <div class="container">
      <div class="cta-row reveal">
        <a href="/packages" class="btn btn-accent">Book a Session</a>
      </div>
    </div>
  </section>

  <section class="gallery-index-section">
    <div class="container">
      <div class="section-narrow reveal">
        <span class="eyebrow-label">Sessions</span>
        <h2>Browse by Session</h2>
      </div>
      <div class="session-index-shell reveal" data-session-index-shell>
        <button class="session-index-arrow session-index-arrow--prev" type="button" aria-label="Previous sessions" data-session-index-prev>
          <span aria-hidden="true"></span>
        </button>
        <nav class="session-index-grid" aria-label="Gallery sessions" data-session-index>
          {
            sessions.map((session, sessionIndex) => (
              <a
                href={`#${session.id}`}
                class="session-index-card"
                aria-label={`View ${session.title} ${sessionIndex + 1}`}
              >
                <img src={session.images[0]} alt="" loading="lazy" />
                <span>{session.eyebrow}</span>
                <strong>{session.title}</strong>
              </a>
            ))
          }
        </nav>
        <button class="session-index-arrow session-index-arrow--next" type="button" aria-label="Next sessions" data-session-index-next>
          <span aria-hidden="true"></span>
        </button>
      </div>
    </div>
  </section>

  {
    sessions.map((session, sessionIndex) => (
      <section
        id={session.id}
        class:list={["gallery-section", sessionIndex % 2 === 1 && "gallery-section--soft"]}
        aria-labelledby={`${session.id}-title`}
      >
        <div class="container">
          <div class="section-narrow gallery-session-heading reveal">
            <span class="eyebrow-label">{session.eyebrow}</span>
            <h2 id={`${session.id}-title`}>{session.title}</h2>
          </div>
          <div class="masonry reveal">
            {
              session.images.map((src, i) => (
                <figure>
                  <img src={src} alt={`${session.eyebrow} portfolio image ${i + 1}`} loading="lazy" />
                </figure>
              ))
            }
          </div>
        </div>
      </section>
    ))
  }

  <section class="gallery-section gallery-booking-section">
    <div class="container">
      <div class="cta-row reveal">
        <a href="/packages" class="btn btn-accent">Book a Session</a>
      </div>
    </div>
  </section>
</Layout>

<script>
  const shell = document.querySelector("[data-session-index-shell]");
  const scroller = document.querySelector("[data-session-index]");
  const previousButton = document.querySelector("[data-session-index-prev]");
  const nextButton = document.querySelector("[data-session-index-next]");

  if (shell && scroller && previousButton && nextButton) {
    const updateArrowState = () => {
      const maxScroll = scroller.scrollWidth - scroller.clientWidth;
      const hasOverflow = maxScroll > 4;
      shell.classList.toggle("session-index-shell--scrollable", hasOverflow);
      previousButton.disabled = !hasOverflow || scroller.scrollLeft <= 4;
      nextButton.disabled = !hasOverflow || scroller.scrollLeft >= maxScroll - 4;
    };

    const scrollByCard = (direction) => {
      const card = scroller.querySelector(".session-index-card");
      const gap = 14;
      const distance = card ? card.getBoundingClientRect().width + gap : scroller.clientWidth * 0.75;
      scroller.scrollBy({ left: distance * direction, behavior: "smooth" });
    };

    previousButton.addEventListener("click", () => scrollByCard(-1));
    nextButton.addEventListener("click", () => scrollByCard(1));
    scroller.addEventListener("scroll", updateArrowState, { passive: true });
    window.addEventListener("resize", updateArrowState);
    updateArrowState();
  }
</script>
