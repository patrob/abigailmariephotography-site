---
import Layout from "../layouts/Layout.astro";

const heroImage =
  "/images/maternity-hero.jpg";

const aboutImage =
  "/images/about-abbie-maternity.jpg";

const lifestyleTeaserImage =
  "/images/lifestyle-newborn-805a1182.jpg";

const familyTeaserImage =
  "/images/805a0333.jpg";

const birthTeaserImage =
  "/images/birth/birth-23.jpg";
---

<Layout title="Home" description="Abigail Marie Photography offers family, maternity, lifestyle, newborn, milestone, and birth photography serving San Antonio and New Braunfels.">
  <section class="hero">
    <img src={heroImage} alt="Maternity portrait session by Abigail Marie Photography" class="hero-image" loading="eager" />
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <p class="eyebrow">Abigail Marie Photography</p>
      <h1 class="hero-quote">A photograph is the pause button on life.</h1>
      <p>
        Relaxed, natural portrait and birth photography for families around the San Antonio and
        New Braunfels areas.
      </p>
      <div class="cta-row hero-cta-row">
        <a href="/gallery" class="btn btn-light">View the Gallery</a>
        <a href="/birth-photography" class="btn btn-light">Birth Photography</a>
        <a href="/contact" class="btn btn-light btn-subtle-light">Plan a Session</a>
      </div>
    </div>
  </section>

  <section class="about-section">
    <div class="container about-grid">
      <div class="about-copy reveal">
        <span class="eyebrow-label">Meet Your Photographer</span>
        <h2>Hi, I'm Abbie.</h2>
        <img
          src={aboutImage}
          alt="Abbie, owner and photographer of Abigail Marie Photography"
          class="about-mobile-photo"
        />
        <p>
          I was born in Arizona, but I got to Texas as soon as I could. I have over 10 years of
          professional photography experience, and I have fallen in love with capturing family
          stories. I'm serving families from San Antonio to New Braunfels. I'm the wife of a
          wonderful man named Patrick, a two-time boy mom, a book lover, and a Jesus follower.
        </p>
        <p>
          At 13, I became fascinated with photography and editing. Then at the age of 15, my mom
          encouraged me to start doing photo sessions for families we knew. That's where it all
          began. I'm all about capturing the special moments in people's lives &mdash; it's my thing.
        </p>
        <p>
          Storytelling is my favorite thing to partner with you in, and I am honored to help
          document your life's most meaningful moments. I work with you to create a truly
          memorable event, from how it looks to how it feels.
        </p>
        <a href="/contact" class="btn">Get in Touch</a>
      </div>
      <div class="about-desktop-photo reveal">
        <img src={aboutImage} alt="Abbie, owner and photographer of Abigail Marie Photography" />
      </div>
    </div>
  </section>

  <section class="session-teaser-section family-teaser-section">
    <div class="container about-grid">
      <div class="reveal">
        <img src={familyTeaserImage} alt="Siblings gathered around a baby during a family photography session" />
      </div>
      <div class="about-copy reveal">
        <h2>Family Sessions</h2>
        <p>
          The giggles, the cuddles, the almost-everyone-looked-at-the-camera moments. Family
          sessions are relaxed, playful, and focused on the connection you already have.
        </p>
        <a href="/packages" class="btn btn-accent">View Family Packages</a>
      </div>
    </div>
  </section>

  <section class="session-teaser-section lifestyle-teaser-section">
    <div class="container about-grid">
      <div class="about-copy reveal">
        <h2>Lifestyle Sessions</h2>
        <p>
          Soft, natural portraits for the seasons you want to remember exactly as they felt,
          from motherhood and milestones to quiet everyday moments with your favorite people.
        </p>
        <a href="/gallery" class="btn">Plan a Session</a>
      </div>
      <div class="reveal">
        <img src={lifestyleTeaserImage} alt="Parents cuddling their newborn during a lifestyle photography session" />
      </div>
    </div>
  </section>

  <section class="session-teaser-section birth-teaser-section">
    <div class="container about-grid">
      <div class="reveal">
        <img src={birthTeaserImage} alt="Newborn resting beside birth announcement and ultrasound photos" />
      </div>
      <div class="about-copy reveal">
        <h2>Birth Photography</h2>
        <p>
          From the last golden days of pregnancy to your baby's first breath, I'm honored to walk
          alongside you and capture the story of how your family grew.
        </p>
        <a href="/birth-photography" class="btn btn-accent">Learn More</a>
      </div>
    </div>
  </section>

</Layout>
