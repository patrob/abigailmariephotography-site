---
import Layout from "../layouts/Layout.astro";

const heroImage = "/images/birth/birth-08.jpg";
const whyImage = "/images/birth/birth-20.jpg";
const feelImage = "/images/birth/birth-25.jpg";
const oncallImage = "/images/birth/birth-39.jpg";

// Placeholder: reusing the homepage maternity portrait until Patrick sends a dedicated photo
const photographerImage = "/images/about-abbie-maternity.jpg";

const closingImage = "/images/birth/birth-33.jpg";

const galleryImages = [
  "01", "02", "03", "04", "05", "06", "07", "09", "10",
  "11", "12", "13", "14", "15", "16", "18", "19", "21",
  "22", "23", "24", "26", "27", "28", "29", "30", "31",
  "32", "34", "36", "37", "38", "40", "41", "42",
].map((n) => `/images/birth/birth-${n}.jpg`);

const packages: {
  name: string;
  price: string;
  popular?: boolean;
  tagline: string;
  description: string;
  includes: string[];
  closing: string;
}[] = [
  {
    name: "Essential Birth",
    price: "$1,000",
    tagline: "The moments you'll never want to forget.",
    description:
      "For families who want the heart of their birth story preserved in a thoughtfully curated collection.",
    includes: [
      "On-call birth photography",
      "Coverage beginning in active labor",
      "Coverage through approximately 1 hour postpartum",
      "Approximately 50 hand-edited images",
      "Private online gallery",
      "High-resolution digital downloads",
      "Print release",
    ],
    closing:
      "A beautiful, intentional collection of the moments that tell the heart of your baby's arrival.",
  },
  {
    name: "Birth Story",
    price: "$1,400",
    popular: true,
    tagline: "From waiting for them to finally holding them.",
    description:
      "Your pregnancy and birth belong to the same story. This collection preserves both — the anticipation before you meet and the incredible day that follows.",
    includes: [
      "On-call birth photography",
      "Coverage beginning in active labor",
      "Coverage through approximately 2 hours postpartum",
      "Approximately 100 hand-edited birth images",
      "30-minute maternity mini session",
      "12 hand-edited maternity images",
      "Private online galleries",
      "High-resolution digital downloads",
      "Print release",
    ],
    closing:
      "For the mama who wants to remember not only the day she met her baby, but the season she spent waiting for them.",
  },
  {
    name: "Heirloom Birth",
    price: "$1,750",
    tagline: "The whole story. Nothing important left behind.",
    description:
      "From the final weeks of carrying your baby to the first hours of holding them, the Heirloom collection is designed to preserve this chapter as completely as possible.",
    includes: [
      "On-call birth photography",
      "Coverage beginning in active labor",
      "Coverage through approximately 2 hours postpartum",
      "Complete curated birth gallery — all of the best images from your story",
      "Full maternity session",
      "30 hand-edited maternity images",
      "Private online galleries",
      "High-resolution digital downloads",
      "Print release",
    ],
    closing:
      "The most complete documentation of the journey from waiting for your baby to finally having them in your arms.",
  },
];

const faqs: { q: string; a?: string; pending?: boolean }[] = [
  {
    q: "What if my labor is really long?",
    a: "Birth doesn't operate on a session timer. We'll discuss coverage expectations before your due date, but my goal is to document the story — not leave because the clock says your time is up.",
  },
  {
    q: "What if I have a C-section?",
    a: "Your birth is still a birth — and absolutely worth documenting. Hospital policies determine whether photography is permitted in the operating room, but there is still so much of your baby's story that can be preserved before and immediately afterward.",
  },
  {
    q: "What if I don't want graphic photographs?",
    a: "You are always in control of what is photographed. We will discuss your preferences beforehand, including whether you'd like images of the actual moment of birth or prefer that I photograph from a more modest perspective.",
  },
  {
    q: "Will you share my birth photographs online?",
    a: "Your birth is deeply personal. We'll discuss image-sharing permissions separately, and your preferences will be respected.",
  },
  {
    q: "What if you miss the birth?",
    a: "I do everything I can to be there — but birth photography is a uniquely demanding niche, and I want to be upfront with you: on rare occasions, I may be unable to attend a birth in person. If that happens, I have a trusted backup photographer (or doula), equipped with my gear, ready to step in and preserve your story in my absence. I personally arrange and pay for my backup, so it's never something you have to coordinate or cover.",
  },
  {
    q: "When should I book?",
    a: "Because I accept only a limited number of births each month in order to remain available for every family, earlier is always better. You don't need to know exactly how or where you'll deliver before reaching out.",
  },
];
---

<Layout title="Birth Photography" description="Birth photography sessions by Abigail Marie Photography in Schertz, TX, serving San Antonio and New Braunfels.">
  <section class="page-hero">
    <img src={heroImage} alt="Birth photography hero" class="hero-image" />
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <p class="eyebrow">Birth Photography</p>
      <h1>The day you meet them deserves to be remembered.</h1>
      <p>
        Birth happens in a blur &mdash; the waiting, the strength you didn't know you had, the
        hand holding yours, the first cry, the tears, and the moment your baby is finally placed
        against your chest. Birth photography allows you to be completely present while I quietly
        preserve the story unfolding around you.
      </p>
    </div>
  </section>

  <section class="verse-section reveal">
    <div class="container">
      <blockquote>
        &ldquo;When a woman gives birth, she has pain because her time has come. But when the child
        is born, she no longer remembers her distress because of her joy that a child has been born
        into the world.&rdquo;
      </blockquote>
      <cite>John 16:21</cite>
    </div>
  </section>

  <section class="birth-why-section">
    <div class="container about-grid">
      <div class="about-copy reveal">
        <span class="eyebrow-label">Why Birth Photography?</span>
        <h2>Because you can't see everything while you're living it.</h2>
        <p>
          You will remember pieces. The intensity. Your partner's hand in yours. The relief when
          you hear that first cry. The weight of your baby against your chest. But there will be
          so much happening around you that you never get to see. The way your partner looked at
          you when you weren't watching. The anticipation in the room. The tears when baby
          arrived. Tiny feet being measured. Grandparents meeting their newest love. The way your
          baby's hand wrapped around a finger for the very first time. My job isn't to interrupt
          any of it. It's simply to notice. And then give those moments back to you.
        </p>
      </div>
      <div class="reveal">
        <img src={whyImage} alt="Partner comforting mother during labor" />
      </div>
    </div>
  </section>

  <section class="birth-experience-section">
    <div class="container about-grid">
      <div class="reveal">
        <img src={feelImage} alt="Quiet, unobtrusive view into a birth room" />
      </div>
      <div class="about-copy reveal">
        <span class="eyebrow-label">&ldquo;What does having a photographer at my birth actually feel like?&rdquo;</span>
        <h2>Quiet. Unobtrusive. Completely centered around you.</h2>
        <p>
          Birth photography isn't a photo shoot. I won't ask you to look at the camera in the
          middle of a contraction. I won't pose you or interrupt what's happening to &ldquo;get
          the shot.&rdquo; I work quietly alongside your birth team, documenting your story as it
          naturally unfolds. Sometimes that means photographing the big moments. Sometimes it's
          your partner rubbing your back. Sometimes it's a dark room and a hand wrapped around
          yours. Sometimes it's the clock on the wall. And when the moment you've been waiting for
          finally arrives, I'm already there &mdash; camera ready &mdash; so you don't have to
          think about documenting a single thing.
        </p>
      </div>
    </div>
  </section>

  <section class="packages-section">
    <div class="container">
      <div class="section-narrow reveal">
        <span class="eyebrow-label">Packages</span>
      </div>

      <div class="packages-grid birth-packages-grid">
        {
          packages.map((pkg) => (
            <div class={`package-card reveal${pkg.popular ? " popular" : ""}`}>
              {pkg.popular && <span class="package-badge">Most Popular</span>}
              <h3>{pkg.name}</h3>
              <p class="package-price">{pkg.price}</p>
              <p class="package-tagline">{pkg.tagline}</p>
              <p class="package-desc">{pkg.description}</p>
              <ul class="package-includes">
                {pkg.includes.map((item) => <li>{item}</li>)}
              </ul>
              <p class="package-closing">{pkg.closing}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="oncall-section">
    <div class="container about-grid">
      <div class="about-copy reveal">
        <h2>When will you come?</h2>
        <p>
          Babies don't tend to care what's written on the calendar. As your due date approaches,
          I'll be on call for you 24/7. We'll stay in communication as labor begins, and I'll join
          you once you're in active labor and remain through your baby's arrival and those first
          precious hours together. Middle of the night? Weekend? Baby decides today is the day?
          That's part of the story.
        </p>
      </div>
      <div class="reveal">
        <img src={oncallImage} alt="A sibling waiting through a long labor" />
      </div>
    </div>
  </section>

  <section class="faq-section">
    <div class="container section-narrow reveal">
      <span class="eyebrow-label">FAQ</span>
      <h2>Common Questions</h2>
    </div>
    <div class="container">
      <div class="faq-list">
        {
          faqs.map((item) => (
            <details class="faq-item reveal">
              <summary>
                <span>{item.q}</span>
                <span class="faq-icon" aria-hidden="true">+</span>
              </summary>
              {item.pending ? (
                <p class="faq-answer copy-pending">
                  Answer pending — this needs exact, carefully written policy language from
                  Patrick (covering precipitous births, failure to notify, illness/emergency,
                  backup photographers, and circumstances outside anyone's control) before this
                  goes live. Do not publish placeholder wording here.
                </p>
              ) : (
                <p class="faq-answer">{item.a}</p>
              )}
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="about-section">
    <div class="container about-grid">
      <div class="reveal">
        {photographerImage ? (
          <img src={photographerImage} alt="Abigail, birth photographer at Abigail Marie Photography" />
        ) : (
          <div class="photo-placeholder">Photo coming soon</div>
        )}
      </div>
      <div class="about-copy reveal">
        <span class="eyebrow-label">Meet Your Birth Photographer</span>
        <p>
          Hi, I'm Abigail &mdash; wife, mom, and the person who'll be quietly capturing your birth
          story.
        </p>
        <p>
          I'm mom to two boys, ages 2 and 4, and most days you'll find me deep in homeschool
          lessons, chasing them around the backyard, or somewhere in between. My faith is at the
          center of how I live and how I show up for the families I photograph &mdash; I'm a
          believer in Jesus and active in my church community, and I carry that same steadiness
          into every birth I attend.
        </p>
        <p>
          I've walked this path myself, twice. My first son was born at a birth center; my second,
          at home. I know what it feels like to be in the middle of that intensity &mdash; the
          waiting, the strength you didn't know you had, the moment it's finally over and your baby
          is placed in your arms. That's part of why I do this work: I understand the vulnerability
          of birth and postpartum from the inside, not just from behind a camera.
        </p>
        <p>
          When I'm in your birth space, my goal is simple &mdash; to be present enough to capture
          what matters, and quiet enough that you forget I'm there at all.
        </p>
      </div>
    </div>
  </section>

  <section class="gallery-section">
    <div class="container">
      <div class="section-narrow reveal">
        <span class="eyebrow-label">Portfolio</span>
        <h2>A Broader Look at Birth Work</h2>
      </div>
      <div class="masonry reveal">
        {
          galleryImages.map((src, i) => (
            <figure>
              <img src={src} alt={`Birth photography portfolio image ${i + 1}`} loading="lazy" />
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <section class="birth-closing-section">
    {closingImage && (
      <>
        <img src={closingImage} alt="" class="hero-image" />
        <div class="hero-overlay" />
      </>
    )}
    <div class="birth-closing-content">
      <p>
        You won't get this day back. Your baby will never be this new again. And although you'll
        tell them the story of the day they were born countless times, one day you'll be able to
        show them, too. The room. The waiting. The people who were there. The first time you held
        them. The way you looked at them. The way they were loved from their very first breath. You
        bring your baby into the world. I'll preserve the story.
      </p>
      <p class="birth-booking-line">Birth photography currently booking for babies due through March 2027.</p>
      <a href="/contact" class="btn btn-rose">Inquire About Your Birth Story</a>
    </div>
  </section>
</Layout>
