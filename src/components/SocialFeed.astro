---
// Paste the SnapWidget embed snippet here once Abbie/Patrick connect
// Instagram (Business/Creator account required) + Facebook at
// snapwidget.com and generate a widget. Example of what it looks like:
//
// const socialEmbed = `<iframe src="https://snapwidget.com/embed/WIDGET_ID" class="snapwidget-widget" style="border:none; overflow:hidden; width:100%;" title="Instagram Widget"></iframe>`;
//
// Until then this renders a simple fallback linking straight to the profiles.
const socialEmbed = "";
---

<section class="social-section">
  <div class="container section-narrow reveal">
    <span class="eyebrow-label">Follow Along</span>
    <h2>Recent <em class="headline-accent">on</em> Instagram &amp; Facebook</h2>
    {socialEmbed ? (
      <div class="social-embed" set:html={socialEmbed} />
    ) : (
      <div class="social-placeholder">
      <p>Posts coming soon &mdash; in the meantime, follow along here:</p>
        <div class="social-links">
          <a href="https://www.instagram.com/abigailmariephotos/" target="_blank" rel="noopener noreferrer">Instagram</a>
          <span class="dot">&middot;</span>
          <a href="https://www.facebook.com/abigailmariephotos/" target="_blank" rel="noopener noreferrer">Facebook</a>
        </div>
      </div>
    )}
  </div>
</section>
